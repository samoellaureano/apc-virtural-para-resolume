{
  "manifest_version": 3,
  "name": "APC Virtual para Resolume",
  "version": "1.2.9",
  "description": "Superficie virtual de pads e faders com mapeamento para o Resolume.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir APC Virtual",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost/api/docs/example/*", "http://127.0.0.1/api/docs/example/*"],
      "js": ["resolume-picker.js"],
      "css": ["resolume-picker.css"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
